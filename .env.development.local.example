# Copy to .env.development.local for local development against local Supabase.
# `next dev` reads this and it overrides .env.local; `next build` ignores it,
# so production still uses .env.local. Fill the anon key from `npm run db:status`.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local anon key from `supabase status`>
