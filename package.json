{
  "name": "finanzas-personales",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0 <21"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-shape": "^3.2.0",
    "lucide-react": "^1.24.0",
    "next": "14.2.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:studio": "open http://localhost:54423",
    "db:status": "supabase status",
    "db:backup-prod": "bash scripts/backup-prod.sh",
    "db:restore-prod": "bash scripts/restore-prod.sh",
    "db:invariants": "bash scripts/check-invariants.sh",
    "db:types": "supabase gen types typescript --local --schema public > types/supabase.ts",
    "db:types:check": "supabase gen types typescript --local --schema public | diff -u types/supabase.ts - && echo 'types in sync'"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.21",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  }
}
